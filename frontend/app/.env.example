# Writz app (Borrow, Lend, Earn, metrics) - environment configuration
# Copy this file to `.env.local` and adjust as needed.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# Which deployment this build is for: "testnet", "mainnet", or unset for local.
# The two real deploy targets set this explicitly; every value below is then
# validated against it at build time (see src/config/target.ts), so a target
# cannot inherit another network's contracts, RPC, or the Earn mock by
# omission. Unset means "local" and validates nothing.
#   testnet -> testnet.writz.xyz   mainnet -> app.writz.xyz (not yet deployed)
# See docs/developers/deploy-targets.md.
NEXT_PUBLIC_WRITZ_ENV=

# Canonical site URL - used for metadataBase/OpenGraph link resolution.
# Defaults to the deploy target's own origin when unset (see src/config/env.ts):
# https://testnet.writz.xyz for testnet, https://app.writz.xyz for mainnet.
NEXT_PUBLIC_SITE_URL=

# Soroban RPC + network
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract addresses (Stellar testnet - see contracts/deployments/testnet.md)
# Borrowing (deposit, borrow, repay, release) runs on writz-lend. The commitment
# tree is read only by the Lend tab until it moves to writz-lend too.
NEXT_PUBLIC_COMMITMENT_TREE_ID=CAQBLCAPGXXCZTJDAJLY7E4PTJYGR6CY4YWH4JSJKFXYIHW3GANP6RFM
NEXT_PUBLIC_BITCOIN_SPV_ID=NEWSPVID
NEXT_PUBLIC_ZK_VERIFIER_ID=CB5XAP6MF2GVVFATFTVCKVEXUODWWRQP4B3QFDMRTM55REP7N2YMXEUD
NEXT_PUBLIC_WRITZ_LEND_ID=NEWLENDID
# The protocol's Bitcoin co-signing public key writz-lend was deployed with.
NEXT_PUBLIC_PROTOCOL_BTC_PUBKEY=03d2f0699b167138988bf8d14a4655a8708066473b4c59ef40ee4ac500564fb70d
# Reflector BTC/USD oracle writz-lend was deployed with. The contract has no
# getter for it, so it must match. Defaults to the testnet Reflector off mainnet.
NEXT_PUBLIC_BTC_ORACLE_ID=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63
# Testnet USDC (USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5) - SAC id, DEX-liquid
NEXT_PUBLIC_USDC_TOKEN_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Issuer of the pool USDC asset (used to build the Enable-USDC trustline)
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Off-chain services (set once deployed - see issues #2 and #14)
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_PROVER_URL=

# Bitcoin confirmations required before a deposit's SPV proof is accepted.
# Must match this deployment's contract: 1 on testnet (see
# contracts/deployments/testnet.md), 6 on mainnet. Defaults to that per target.
NEXT_PUBLIC_BITCOIN_MIN_CONFIRMATIONS=1

# Smallest deposit in sats. Must match writz-lend's min_deposit_satoshis:
# 5000 on testnet, 100000 on mainnet. Defaults to that per target.
NEXT_PUBLIC_MIN_DEPOSIT_SATS=5000

# Earn - DeFindex USDC vault
# The vault address and the DeFindex API key are relayer-side only, so there is
# no vault id here. The Earn tab reads and builds transactions through the
# relayer's /defindex routes (NEXT_PUBLIC_RELAYER_URL above).
#
# The classic Stellar asset the vault accepts. NOT the same asset as
# NEXT_PUBLIC_USDC_ISSUER above: the lending pool runs on a DEX-liquid testnet
# USDC, while the vault was created against Blend's own test USDC, because a
# DeFindex vault only accepts its strategy's asset. Same "USDC" code, different
# issuer, and in Stellar that makes them unrelated assets. Current value is the
# "Underlying asset" row of contracts/deployments/defindex-vault-testnet.md.
# On mainnet both are Circle's USDC and these two will match.
# The DeFindex vault contract, shown on the Protocol page (reads go through the
# relayer). Defaults to the testnet vault off mainnet; required on mainnet.
NEXT_PUBLIC_EARN_VAULT_ID=CBMHGL7GGGHODEDDJ5H2LKJEFHJWBRSQUKOXMC4FKOFDZK5HBKW6PI2S
NEXT_PUBLIC_EARN_ASSET_CODE=USDC
NEXT_PUBLIC_EARN_ASSET_ISSUER=GATALTGTWIOT6BUDBCZM3Q4OQ4BO2COLOAZ7IYSKPLC2PMSOPPGF5V56
# Where a tester gets that asset. Shown in the Earn tab when the connected
# account holds none of it. Leave empty to hide the hint.
NEXT_PUBLIC_EARN_FAUCET_URL=https://testnet.blend.capital

# Pollar - email, Google and GitHub sign-in with a custodial testnet wallet
# whose fees the app sponsors. Publishable key (pub_testnet_...) from the
# Pollar dashboard. Testnet only: the mainnet target refuses to build with it
# set. Empty hides the option; the Stellar Wallets Kit path works without it.
NEXT_PUBLIC_POLLAR_API_KEY=

# Umami - pageview analytics (https://cloud.umami.is). Find the website ID
# under Settings > Websites. Note: this ID is not a secret - it ends up in
# the rendered page's data-website-id attribute regardless of where it's
# sourced from. Env-based config here is for deploy hygiene (no hardcoded
# IDs in source, easy to swap per environment), not confidentiality.
# When left empty, the tracking script is not injected.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
