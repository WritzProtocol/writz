# Writz frontend - environment configuration
# Copy this file to `.env.local` and adjust as needed.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# Canonical site URL - used for metadataBase/OpenGraph link resolution.
# Defaults to https://writz.xyz when unset (see src/config/env.ts).
NEXT_PUBLIC_SITE_URL=https://writz.xyz

# Soroban RPC + network
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract addresses (Soroban testnet - see contracts/deployments/testnet.md)
NEXT_PUBLIC_COMMITMENT_TREE_ID=CDQCTFO3FK3M47QS47O2A4WLNPSQAQBSXBFPJ6RZEHFO5D7RY34FSBBP
NEXT_PUBLIC_BITCOIN_SPV_ID=CB2BD6QCSZVNZN5NLI7C5NF356WXVJDSXT6LVAQFWHHS4SZ4NCKKNIVA
NEXT_PUBLIC_ZK_VERIFIER_ID=CBNZU23QGCZATJB2QMNF2K6IST2SVP7FSGCKASQNBULTWDWGANDBYLFY
NEXT_PUBLIC_PRIVATE_LEND_ID=CAAWVMDRUPEJNELSQ6RU2VMVX5EJLQ2E77T7IXDWGMW4DGSNAGECGSWR
# Testnet USDC (USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5) - SAC id, DEX-liquid
NEXT_PUBLIC_USDC_TOKEN_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Issuer of the pool USDC asset (used to build the Enable-USDC trustline)
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Off-chain services (set once deployed - see issues #2 and #14)
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_PROVER_URL=

# Bitcoin confirmations required before a deposit's SPV proof is accepted.
# Must match this deployment's contract expectation - 6 on mainnet (see
# docs/products/privatelend.md); testnet/signet deployments commonly run 1
# (see contracts/deployments/testnet.md). Drives the deposit progress bar.
NEXT_PUBLIC_BITCOIN_MIN_CONFIRMATIONS=6

# Privy - embedded wallet / social login (email, Google, Twitter, Discord, GitHub)
# Create an app at https://dashboard.privy.io and copy the App ID here.
# When left empty, the "Email / Social" connect option is disabled; the
# Stellar Wallets Kit path continues to work without Privy.
NEXT_PUBLIC_PRIVY_APP_ID=

# Umami - pageview analytics (https://cloud.umami.is). Find the website ID
# under Settings > Websites. Note: this ID is not a secret - it ends up in
# the rendered page's data-website-id attribute regardless of where it's
# sourced from. Env-based config here is for deploy hygiene (no hardcoded
# IDs in source, easy to swap per environment), not confidentiality.
# When left empty, the tracking script is not injected.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Server-side secrets (NOT NEXT_PUBLIC - never exposed to the browser) ──
# AWS KMS key ID (or alias, e.g. "alias/writz-protocol-key") for the protocol
# Bitcoin co-signing key used by POST /api/cosign. The key must
# be an asymmetric ECC_SECG_P256K1 / ECDSA_SHA_256 KMS key; the private key
# material never leaves KMS. Requires AWS credentials with kms:Sign and
# kms:GetPublicKey on this key available to the runtime (e.g. via the
# standard AWS SDK credential chain - do not hardcode credentials here).
# Preferred over PROTOCOL_SIGNING_KEY below whenever both are set.
KMS_KEY_ID=
# WIF-encoded protocol signing key - testnet/signet-only fallback used when
# KMS_KEY_ID isn't set (e.g. while AWS KMS account setup is in progress).
# resolveProtocolSigner refuses this on mainnet (BITCOIN_NETWORK=mainnet)
# and throws instead of starting - see docs/security/security-model.md.
PROTOCOL_SIGNING_KEY=
# Bitcoin network for co-signing: "testnet" (default) or "mainnet".
BITCOIN_NETWORK=testnet
