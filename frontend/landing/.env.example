# Writz landing - environment configuration
# Copy this file to .env.local and adjust as needed.

# Canonical site URL, used for metadataBase/OpenGraph link resolution.
NEXT_PUBLIC_SITE_URL=https://writz.xyz

# Where the four "Launch App" CTAs point.
NEXT_PUBLIC_APP_URL=https://testnet.writz.xyz

# Umami pageview analytics website ID. Leave empty to disable tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
