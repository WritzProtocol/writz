{
  "name": "@writz/relayer",
  "version": "0.1.0",
  "description": "Bitcoin SPV proof relayer for Writz Protocol",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:bun": "bun test test/insert-auth.bun.test.ts test/tree-decode.bun.test.ts test/faucet-store.bun.test.ts test/deposit-reads.bun.test.ts test/deposit-submission.bun.test.ts test/cctp-relay-store.bun.test.ts test/timeline-reads.bun.test.ts test/soroban-fee.bun.test.ts",
    "test:e2e": "bun test test/earn-cycle.e2e.test.ts",
    "check:tree-archive": "bun scripts/check-tree-archive.ts",
    "rebuild-tree": "bun src/tree-rebuild/cli.ts",
    "faucet:keygen": "bun scripts/faucet-keygen.ts",
    "cctp-relay:keygen": "bun scripts/cctp-relay-keygen.ts"
  },
  "dependencies": {
    "@defindex/sdk": "^0.3.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "@writz/bitcoin-script": "file:../bitcoin-script",
    "commitment-tree": "file:../privacy/packages/commitment-tree",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "0.7.6",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.3.14",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8"
  }
}
