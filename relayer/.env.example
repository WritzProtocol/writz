# Writz Relayer - environment variables
# Copy to .env and fill in values before running.

# Which deployment this relayer process is for: "testnet", "mainnet", or unset
# for local. The two real deploy targets set this explicitly; the process then
# refuses to boot if the values below contradict it (see src/deploy-target.ts),
# which is what keeps a cloned service from serving the wrong network's vault.
# Unset means "local" and validates nothing.
# See docs/developers/deploy-targets.md.
WRITZ_ENV=

# TCP port the relayer listens on (default: 3000)
PORT=3000

# Bitcoin network: "mainnet" or "signet" (default: mainnet)
# "testnet" is accepted as a legacy alias for "signet"
BITCOIN_NETWORK=mainnet

# Esplora API base URL.
# Defaults to mempool.space for the chosen network (Blockstream's public API
# rate-limits unauthenticated callers too tightly for the header sync).
# ESPLORA_URL=https://mempool.space/signet/api

# Optional second Esplora base URL for /spv-proof, tried when the primary
# answers 429/5xx or is unreachable. It must serve the same Esplora REST API
# for the same network (Blockstream's does, byte for byte). Unset: no fallback.
# ESPLORA_FALLBACK_URL=https://blockstream.info/signet/api

# Retries per Esplora host on 429, 5xx and network errors for /spv-proof
# (default: 2; backoff 250 ms, then doubling). The header sync keeps its own.
# ESPLORA_RETRIES=2

# Reverse-proxy hops trusted for the client IP (default: 1, Railway's edge).
# Rate limits key on the address that hop wrote, so a caller cannot choose
# its own bucket by sending X-Forwarded-For. 0 trusts no proxy.
# TRUST_PROXY_HOPS=1

# Per-IP budget for GET /spv-proof (default: 60 requests per 60000 ms).
# SPV_PROOF_RATE_LIMIT=60
# SPV_PROOF_RATE_WINDOW_MS=60000

# Per-IP budget for GET /deposit-status (default: 120 requests per 60000 ms).
# DEPOSIT_STATUS_RATE_LIMIT=120
# DEPOSIT_STATUS_RATE_WINDOW_MS=60000

# In-memory proof cache: max entries (default: 1000) and lifetime of a proof
# whose block is at least 6 deep (default: 3600000 = 1 h).
# SPV_PROOF_CACHE_MAX_ENTRIES=1000
# SPV_PROOF_CACHE_TTL_MS=3600000

# Allowed CORS origin(s) for browser requests.
# Use "*" to allow all origins (default).
# Use a comma-separated list to restrict: "https://app.writz.io,http://localhost:3001"
CORS_ORIGIN=*

# Minimum confirmations returned when the caller doesn't specify (default: 6)
DEFAULT_CONFIRMATIONS=6

# Maximum confirmations a caller may request (default: 20)
MAX_CONFIRMATIONS=20

# HTTP request timeout for Esplora calls in milliseconds (default: 10000)
REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Stellar / Soroban
# ---------------------------------------------------------------------------

# Soroban RPC endpoint (defaults to public testnet)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase (defaults to testnet)
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban contract address for the commitment-tree contract
COMMITMENT_TREE_ID=

# Admin Stellar secret key - used to sign insert_commitment transactions.
# Must match the account configured as admin in the deployed contract.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Repay watcher (auto-cosign on full repayment)
# ---------------------------------------------------------------------------

# Soroban contract address for the writz-lend contract
WRITZ_LEND_ID=

# Relayer's own Stellar secret key - used to sign publish_release_psbt
# transactions. Must match the account configured as `relayer` in the
# deployed writz-lend contract (see `set_relayer`).
RELAYER_SECRET=

# AWS KMS key ID (or alias) for the protocol Bitcoin co-signing key.
# The repay watcher signs every release with it; the app holds no signing
# key. Must be the key writz-lend was deployed with. Requires AWS
# credentials with kms:Sign and
# kms:GetPublicKey on this key available to the runtime.
# Preferred over PROTOCOL_SIGNING_KEY below whenever both are set.
KMS_KEY_ID=

# WIF-encoded protocol signing key - testnet/signet-only fallback used when
# KMS_KEY_ID isn't set (e.g. while AWS KMS account setup is in progress).
# Same custody model as frontend's PROTOCOL_SIGNING_KEY; resolveProtocolSigner
# refuses it on mainnet (BITCOIN_NETWORK=mainnet) and throws at startup
# instead - see docs/security/security-model.md.
PROTOCOL_SIGNING_KEY=

# Miner fee (satoshis) subtracted from the release amount when building the
# co-signed release PSBT (default: 1500, ~10 sat/vbyte for a ~149 vbyte
# release tx - see contracts/deployments/testnet.md's e2e test data point).
# Fixed rather than dynamically estimated - dynamic fee estimation is an
# intentionally out-of-scope refinement for now.
RELEASE_FEE_SAT=1500

# How often (ms) the repay watcher polls Soroban RPC for new repay_full
# events (default: 30000 = 30s).
REPAY_WATCHER_POLL_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# bitcoin-spv header sync
# ---------------------------------------------------------------------------
# Submits Bitcoin headers to bitcoin-spv so deposits can be verified against
# them. Signed with RELAYER_SECRET, which must be the account set as the
# contract's submitter (`set_submitter`, mandatory on signet). Off until
# BITCOIN_SPV_ID, SPV_SYNC_FROM_HEIGHT and RELAYER_SECRET are all set.

# Soroban contract address for the bitcoin-spv contract
BITCOIN_SPV_ID=

# The height of the checkpoint bitcoin-spv was configured with
# (`set_checkpoint`); syncing starts from the block after it.
SPV_SYNC_FROM_HEIGHT=

# How often (ms) to look for new headers (default: 60000 = 60s).
SPV_SYNC_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# ZK keeper (#212)
# ---------------------------------------------------------------------------
# Liquidates undercollateralized commitment-tree positions without their
# owners. Every borrow and repay proof encrypts the new position's
# liquidation witness to commitment-tree's keeper key; the tree watcher hands
# those notes to the keeper, which opens them with KEEPER_BABYJUB_SECRET.
# That secret can liquidate positions but never borrow against or release
# them. Off until COMMITMENT_TREE_ID, KEEPER_BABYJUB_SECRET and KEEPER_SECRET
# are all set. Lending targets only; refused on mainnet (Earn only).

# BabyJubJub scalar from scripts/deploy/keeper_keygen.mjs (0x... hex). Its
# public key is what commitment-tree was constructed with (or set_keeper_pubkey).
KEEPER_BABYJUB_SECRET=

# Stellar secret of the account that pays a liquidated position's debt in
# USDC. Needs XLM for fees and enough USDC to cover the debts it liquidates.
KEEPER_SECRET=

# How often (ms) the keeper re-checks positions (default: 60000).
KEEPER_POLL_INTERVAL_MS=60000

# Must equal commitment-tree's oracle price and liquidation threshold, or
# liquidation proofs fail on-chain. Defaults match the contract (Phase 1
# oracle stub: $60,000 per BTC; 120%).
# BTC_PRICE_STROOPS=600000000000
# LIQUIDATION_THRESHOLD_BP=12000

# ---------------------------------------------------------------------------
# Signet faucet (GET/POST /faucet/signet, GET /faucet/signet/nonce)
# ---------------------------------------------------------------------------
# Pays a fixed amount of Signet test BTC from a relayer-held P2WPKH wallet to
# accounts created through the Writz testnet app's social login, once per
# Pollar account, Stellar address and Signet address. Not a public faucet:
# builders use public Signet faucets (signetfaucet.com and others).
# Mounted only when BITCOIN_NETWORK=signet and the target is not mainnet.
# Without FAUCET_SIGNET_WIF, POLLAR_SECRET_KEY and POLLAR_APPLICATION_ID the
# routes answer 503 faucet_disabled; the faucet never pays without a login.
#
# Generate the key straight into the deployment's secrets (never commit it):
#   railway variables --service writz --set "FAUCET_SIGNET_WIF=$(bun scripts/faucet-keygen.ts --wif-only)"
# then read the address to fund from GET /faucet/signet. For local use,
# `bun run faucet:keygen` prints a key and its address.
# Must be a different key from PROTOCOL_SIGNING_KEY (refused otherwise), and
# is refused unless BITCOIN_NETWORK=signet. Every numeric FAUCET_* value below
# must be positive; the relayer refuses to start otherwise.
FAUCET_SIGNET_WIF=

# false switches the faucet off without removing the key (default: true).
# FAUCET_ENABLED=true

# Pollar Server API credentials of the testnet app, used to verify the social
# login behind each claim (POST /v3/tokens/verify). The secret key is a
# sec_testnet_ key from the Pollar dashboard, Build > API Keys (shown once);
# a sec_mainnet_ key is refused, and the mainnet target refuses this variable.
# The application id is under Settings > App ID. Never commit either.
POLLAR_SECRET_KEY=
POLLAR_APPLICATION_ID=
# POLLAR_API_URL=https://server.api.pollar.xyz/v3

# true lets email one-time-code logins claim too (default: false, Google and
# GitHub only; email codes accept disposable addresses).
# FAUCET_ALLOW_EMAIL=false

# Sats per claim (default: 20000; allowed 1000 to 50000). 20,000 covers one
# deposit at the testnet minimum plus fees and a second attempt.
# FAUCET_AMOUNT_SATS=20000

# Claims per UTC day across all callers (default: 300).
# FAUCET_DAILY_CAP=300

# Claims per client IP within any FAUCET_IP_WINDOW_HOURS (sliding window;
# defaults: 20 per 1 hour). Sized so a shared network (an event venue, a
# classroom) can onboard its people in one session.
# FAUCET_IP_CLAIMS_PER_WINDOW=20
# FAUCET_IP_WINDOW_HOURS=1

# Fee rate: Esplora's estimate for FAUCET_FEE_TARGET_BLOCKS, clamped to
# [FAUCET_MIN_FEE_RATE, FAUCET_MAX_FEE_RATE] sat/vbyte (defaults: 3, 2, 25).
# FAUCET_FEE_TARGET_BLOCKS=3
# FAUCET_MIN_FEE_RATE=2
# FAUCET_MAX_FEE_RATE=25

# Per-IP claim attempts, successful or not, per window (default: 30 per
# 600000 ms). A burst limit on top of the claim limits above; nonce requests
# have their own budget of the same size.
# FAUCET_RATE_LIMIT=30
# FAUCET_RATE_WINDOW_MS=600000

# Claim records, so the one-claim rules, the per-IP allowance and the daily
# count survive restarts
# (default: data/faucet.db; keep data/ on a volume).
# FAUCET_SQLITE_PATH=data/faucet.db

# ---------------------------------------------------------------------------
# CCTP relay to Base Sepolia (POST /cctp/relay, GET /cctp/relay[/:burnHash])
# ---------------------------------------------------------------------------
# Completes on Base Sepolia the USDC transfers borrowers burn on Stellar with
# Circle CCTP V2, paying the gas from the relay's own account. Mounted only
# where lending is enabled; the mainnet target refuses to boot with the key.
# Unset key: the routes answer 503 cctp_relay_disabled.
#
# Generate the key straight into the deployment's secrets (never commit it);
# the command prints only the address to fund with Base Sepolia ETH:
#   railway variables --service writz --set "CCTP_RELAY_EVM_KEY=$(bun scripts/cctp-relay-keygen.ts --key-only)"
# For local use, `bun run cctp-relay:keygen` prints a key and its address.
CCTP_RELAY_EVM_KEY=

# false switches the relay off without removing the key (default: true).
# CCTP_RELAY_ENABLED=true

# Base Sepolia RPC (must serve chain 84532) and Circle's Iris API.
# CCTP_RELAY_RPC_URL=https://sepolia.base.org
# CCTP_IRIS_URL=https://iris-api-sandbox.circle.com

# How long to wait for Circle to confirm a burn (default: 30 minutes), mints
# per UTC day (default: 200), transfers in flight (default: 50), and how far
# back to look for a mint someone else sent (default: 10000 blocks).
# CCTP_RELAY_CONFIRM_TIMEOUT_MINUTES=30
# CCTP_RELAY_DAILY_CAP=200
# CCTP_RELAY_MAX_IN_FLIGHT=50
# CCTP_RELAY_MINT_LOOKBACK_BLOCKS=10000

# When the RPC search above misses a mint someone else sent, the relay asks
# this keyless Blockscout API (etherscan-compatible logs/getLogs) by nonce
# and keeps only a log from MessageTransmitterV2 with the MessageReceived
# signature and that nonce. Empty: RPC only.
# CCTP_RELAY_MINT_INDEXER_URL=https://base-sepolia.blockscout.com/api

# Per-IP POST attempts per window (default: 30 per 600000 ms).
# CCTP_RELAY_RATE_LIMIT=30
# CCTP_RELAY_RATE_WINDOW_MS=600000

# Relay records, so transfers in flight resume and mint hashes survive a
# restart (default: data/cctp-relay.db; keep data/ on a volume).
# CCTP_RELAY_SQLITE_PATH=data/cctp-relay.db

# ---------------------------------------------------------------------------
# DeFindex (Earn)
# ---------------------------------------------------------------------------

# DeFindex API key (starts with "sk_"). Generate one at console.defindex.io
# under API Keys - see docs.defindex.io/integration-guide/guides-and-tutorials/getting-api-key.
# Required by the `defindex` router (#103) for both reads (balance, APY,
# managed funds) and transaction-building (deposit, withdraw). Also used by
# scripts/deploy/deploy_defindex_vault.mjs and rebalance_defindex_vault.mjs
# (#102), which go through the DeFindex API rather than a raw factory
# contract invoke - that key is separate from this one (see
# scripts/deploy/.env.example) but it's the same value.
DEFINDEX_API_KEY=

# DeFindex API base URL (default: https://api.defindex.io)
# DEFINDEX_API_URL=https://api.defindex.io

# Writz's own DeFindex vault contract ID (testnet address recorded in
# contracts/deployments/defindex-vault-testnet.md). Required by the
# `defindex` router (#103) - one vault per network, never a request param.
DEFINDEX_VAULT_ID=

# How often (ms) the vault watcher (#114) polls Soroban RPC for new
# deposit/withdraw events on DEFINDEX_VAULT_ID (default: 30000 = 30s).
VAULT_WATCHER_POLL_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Earn end-to-end test (#112) - test/earn-cycle.e2e.test.ts
# ---------------------------------------------------------------------------
# These are only read by that suite. It is the one test in the repo that
# submits real transactions, so it is off unless deliberately configured.

# Testnet secret key (S...) that signs the cycle's deposit and withdrawal.
# Needs XLM for fees and a balance of the vault's underlying asset. Use a
# throwaway testnet account - never a key with mainnet value.
EARN_E2E_SIGNER_SECRET=

# Amount to deposit and then withdraw, in USDC stroops (default: 1000000 =
# 0.1 USDC). Kept small because every run really spends it.
EARN_E2E_AMOUNT_STROOPS=1000000

# Set to 1 to make missing configuration a failure instead of a warn-and-skip.
# Use it when you mean to actually exercise the cycle and want proof it ran,
# rather than a pass that skipped. Leave unset for ordinary local runs.
EARN_E2E_REQUIRED=
