# Admin / deployer secret for testnet ops (set_vkeys, e2e, deploy_defindex_vault).
# Testnet only. Copy to .env (git-ignored) and fill in. Never commit the real secret.
WRITZ_DEV_SECRET=

# DeFindex API key (starts with "sk_"), for deploy_defindex_vault.mjs.
# Generate at console.defindex.io under API Keys. The *_mainnet scripts need a
# separate mainnet-only key - never reuse the testnet one.
DEFINDEX_API_KEY=

# Fresh, funded mainnet account for create_manager_multisig.mjs. Useless once the
# multisig is configured (master weight 0) - remove it afterward.
MANAGER_SECRET=

# Mainnet Rebalance Manager key for the Writz DeFindex vault. Long-lived - back it up.
MAINNET_REBALANCE_SECRET=

# deploy_stack.mjs - the coordinated redeploy (#177). Dry run unless --execute.
# STELLAR_NETWORK: local | testnet | mainnet. BITCOIN_NETWORK: signet | mainnet.
STELLAR_NETWORK=
BITCOIN_NETWORK=
# Required on mainnet: a Soroban RPC provider endpoint.
RPC_URL=
# Deployer and admin of every contract. Move it behind the multisig afterwards.
ADMIN_SECRET=
# G... of the relayer's RELAYER_SECRET (private-lend relayer, signet header submitter).
RELAYER_ADDRESS=
KEEPER_ADDRESS=
# C... USDC Stellar Asset Contract and Reflector oracle.
USDC_TOKEN=
ORACLE=
# 33-byte compressed hex key matching the relayer's KMS key / PROTOCOL_SIGNING_KEY.
PROTOCOL_PUBKEY=
# bitcoin-spv checkpoint: a recent block's header fields. CHECKPOINT_HASH in
# explorer (display) byte order; CHECKPOINT_PERIOD_START_TIME is the timestamp of
# block `height - height % 2016`, the first block of its difficulty period.
CHECKPOINT_HEIGHT=
CHECKPOINT_HASH=
CHECKPOINT_BITS=
CHECKPOINT_TIME=
CHECKPOINT_PERIOD_START_TIME=
MIN_CONFIRMATIONS=6
# Optional private-lend exposure cap in USDC stroops (contract default: 50,000 USDC).
MAX_TOTAL_BORROWED=
# Mainnet only: set once the project owner has signed off the deploy.
CONFIRM_MAINNET=
