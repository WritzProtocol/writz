# Admin / deployer secret for testnet ops (set_vkeys, e2e, deploy_defindex_vault).
# Testnet only. Copy to .env (git-ignored) and fill in. Never commit the real secret.
WRITZ_DEV_SECRET=

# DeFindex API key (starts with "sk_"), for deploy_defindex_vault.mjs.
# Generate at console.defindex.io under API Keys.
DEFINDEX_API_KEY=
