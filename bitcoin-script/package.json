{
  "name": "@writz/bitcoin-script",
  "version": "0.1.0",
  "description": "P2WSH locking script construction and transaction signing for Writz Protocol",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format cjs --sourcemap",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e:testnet": "bun run scripts/e2e_testnet.mjs",
    "e2e:dryrun": "bun run scripts/e2e_testnet.mjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.699.0",
    "@bitcoinerlab/secp256k1": "^1.0.5",
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "eslint": "^9",
    "globals": "^17.8.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8"
  }
}
