{
  "name": "@writz/sdk",
  "version": "0.1.0",
  "description": "Prove Bitcoin transactions on Stellar and read the Writz lending pool: network presets, relayer client, bitcoin-spv and writz-lend clients",
  "license": "Apache-2.0",
  "homepage": "https://docs.writz.xyz/developers/integrate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WritzProtocol/writz.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/WritzProtocol/writz/issues",
  "keywords": [
    "stellar",
    "soroban",
    "bitcoin",
    "spv",
    "light-client",
    "writz"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "WRITZ_LIVE=1 bun test test/live.test.ts",
    "check:browser": "bun build src/index.ts --target browser --outdir .browser-check"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
